{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "../dsh-harness-plus/node_modules/@types"
    ],
    "types": ["node"],
    "paths": {
      "@kewen/dsh-ui": ["../packages/dsh-ui/src/index.ts"],
      "@kewen/dsh-ui/*": ["../packages/dsh-ui/src/*"]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
